# Postgres connection string
DATABASE_URL="postgresql://clientdesk:clientdesk@localhost:5432/clientdesk"

# Public URL of the app (used in emails and Stripe redirects)
APP_URL="http://localhost:3000"

# Where uploaded deliverable files are stored on disk
UPLOAD_DIR="./storage/uploads"
# Maximum upload size per file, in megabytes
MAX_UPLOAD_MB=50

# Email (optional). Any nodemailer SMTP URL, e.g. smtp://user:pass@smtp.postmarkapp.com:587
# When unset, emails are printed to the server console instead of being sent.
SMTP_URL=""
EMAIL_FROM="ClientDesk <no-reply@clientdesk.local>"

# Stripe (optional; required for online invoice payment)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# "false" (default): payments land in the Stripe account above — right for a single agency
#   running its own copy of ClientDesk.
# "true": multi-tenant mode. Each agency connects its own Stripe Express account from
#   Settings and funds are routed to it with destination charges.
STRIPE_CONNECT_ENABLED="false"
